# Variáveis de ambiente do app web — referência.
# Em produção (Vercel), configure no dashboard: Settings → Environment Variables.
# Localmente, copie para apps/web/.env.local

# Supabase — Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL base do app (sem barra no final)
# Local: http://localhost:3001
# Produção: https://assistencianet.vercel.app (ou domínio custom)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# URL pública do app usada para registrar o webhook na Evolution API automaticamente.
# Local: use ngrok (ex: https://abc123.ngrok-free.app) — não funciona com localhost
# Produção: mesma URL do NEXT_PUBLIC_SITE_URL
APP_BASE_URL=

# Evolution API — Modelo A (gerenciada pelo SaaS, não exposta ao cliente)
# URL e key da instância Evolution API compartilhada
EVOLUTION_BASE_URL=https://evolution.smartconserto.com.br
EVOLUTION_API_KEY=
# Secret compartilhado entre a Evolution e o app para autenticar webhooks recebidos
EVOLUTION_WEBHOOK_SECRET=
